# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jobtrackr?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# AI parsing (free OpenRouter models work without credits)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
# Optional: a model to try first (e.g. openai/gpt-4o-mini, needs credits); the free models follow
# OPENROUTER_MODEL=
# Optional: comma-separated replacement for the built-in free-model chain
# OPENROUTER_FREE_MODELS=
